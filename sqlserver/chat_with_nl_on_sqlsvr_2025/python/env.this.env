# AI Provider Configuration
# Works with GitHub Models OR Microsoft Foundry - just change the values below!

# =============================================================================
# OPTION 1: GitHub Models (Free - Good for Learning)
# =============================================================================
# Get your GitHub Personal Access Token at: https://github.com/settings/tokens
# No special scopes needed - just generate a token

AI_API_KEY=your-api-key
AI_ENDPOINT=https://models.inference.ai.azure.com
AI_MODEL=Phi-4-multimodal-instruct
AI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI configuration - only needed if using Azure OpenAI instead of GitHub Models
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano


# OpenTelemetric Variables
OTLP_SERVICE_NAME='langchain-sql-demo'
OTLP_SERVICE_VERSION='1.0.0'
OTLP_SERVICE_ENVIRONMENT='local'
OTLP_SERVICE_ENDPOINT='http://localhost:4318/v1/traces'
OTLP_TRACES_ENDPOINT='http://localhost:16686/'



# =============================================================================
# OPTION 2: Microsoft Foundry (Paid - For Production)
# =============================================================================
# Uncomment these lines and comment out the GitHub Models section above
# Get your Azure OpenAI endpoint and key from Azure Portal

# AI_API_KEY=your_azure_openai_api_key
# AI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
# AI_MODEL=gpt-5-mini
# AI_EMBEDDING_MODEL=text-embedding-ada-002